# LogicFuzz environment template — copy to `logicfuzz.env` and fill in your keys.
#
#   cp logicfuzz.env.example logicfuzz.env   # then edit
#
# `logicfuzz.env` is auto-loaded at startup by run_logicfuzz.py (load_dotenv) and
# is GITIGNORED. This `.example` carries NO secrets and is safe to commit.

# --- LLM provider keys ---------------------------------------------------
# OpenAI — required for the default models (gpt-*, src/llm/models.py) AND the T7
# embedding fallback (text-embedding-3-large). One key covers both.
OPENAI_API_KEY=sk-proj-REPLACE_ME

# Optional — only needed if you select these providers (e.g. -l deepseek-chat
# / -l claude-3-5-sonnet):
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=

# --- Optional config (defaults are fine; see CLAUDE.md for the full knob list) ---
# LOGICFUZZ_FI_ENDPOINT=        # FuzzIntrospector endpoint override
# LOGICFUZZ_TOP_K=              # skeleton/driver count (union-breadth lever)
