# LogicFuzz Docker environment configuration example 

# The real logicfuzz.env file is loaded by `docker run --env-file logicfuzz.env` in `docs/DOCKER_SETUP.md`.

# Qwen / DashScope API key (for models like `qwen3-coder-plus`)
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# OpenAI API key (if you use OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here 

# DeepSeek API key (required for deepseek-chat model)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Model configuration
LOGICFUZZ_MODEL=deepseek-chat

# PGFilter (Source Filter) configuration
ENABLE_SOURCE_FILTER=true
SOURCE_FILTER_MIN_LINES=50

