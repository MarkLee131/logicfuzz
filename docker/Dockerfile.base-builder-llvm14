# LogicFuzz custom base-builder with LLVM 14 for bitcode extraction
#
# This image extends OSS-Fuzz base-builder with:
# - LLVM 14 (clang-14, llvm-14) for bitcode generation compatible with host extractor
# - libc++-14-dev for C++ projects using -stdlib=libc++
# - wllvm for whole-program LLVM bitcode extraction
#
# Build: docker build -f Dockerfile.base-builder-llvm14 -t logicfuzz/base-builder-llvm14 .
#
# NOTE: Using default tag (Ubuntu 20.04 based) to ensure GLIBC compatibility with base-runner:latest
# Ubuntu 24.04 has GLIBC 2.38 which is incompatible with base-runner's older GLIBC

FROM gcr.io/oss-fuzz-base/base-builder

# Add LLVM 14 repository for Ubuntu 20.04 (focal)
RUN apt-get update && apt-get install -y \
    wget \
    gnupg \
    software-properties-common \
    && wget -O - https://apt.llvm.org/llvm-snapshot.gpg.key | apt-key add - \
    && add-apt-repository "deb http://apt.llvm.org/focal/ llvm-toolchain-focal-14 main" \
    && apt-get update

# Install LLVM 14 and libc++ 14
RUN apt-get install -y \
    clang-14 \
    llvm-14 \
    llvm-14-dev \
    llvm-14-tools \
    llvm-14-runtime \
    libc++-14-dev \
    libc++abi-14-dev \
    && rm -rf /var/lib/apt/lists/*

# Install wllvm for bitcode extraction
RUN pip3 install wllvm

# Create symlinks so linker can find libc++ in standard paths
RUN ln -sf /usr/lib/llvm-14/lib/libc++.so /usr/lib/x86_64-linux-gnu/libc++.so && \
    ln -sf /usr/lib/llvm-14/lib/libc++.so.1 /usr/lib/x86_64-linux-gnu/libc++.so.1 && \
    ln -sf /usr/lib/llvm-14/lib/libc++.so.1.0 /usr/lib/x86_64-linux-gnu/libc++.so.1.0 && \
    ln -sf /usr/lib/llvm-14/lib/libc++abi.so /usr/lib/x86_64-linux-gnu/libc++abi.so && \
    ln -sf /usr/lib/llvm-14/lib/libc++abi.so.1 /usr/lib/x86_64-linux-gnu/libc++abi.so.1 && \
    ldconfig

# Verify installation
RUN clang-14 --version && \
    llvm-config-14 --version && \
    which wllvm && \
    test -f /usr/lib/x86_64-linux-gnu/libc++.so

# Set environment variables for LLVM 14
ENV LLVM_CONFIG=/usr/bin/llvm-config-14
