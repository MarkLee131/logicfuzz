# LogicFuzz custom base-builder with LLVM 14 for bitcode extraction
#
# This image extends OSS-Fuzz base-builder with:
# - LLVM 14 (clang-14, llvm-14) for bitcode generation compatible with host extractor
# - libc++-14-dev for C++ projects using -stdlib=libc++
# - wllvm for whole-program LLVM bitcode extraction
#
# Build: docker build -f Dockerfile.base-builder-llvm14 -t logicfuzz/base-builder-llvm14 .
#
# NOTE: Using default tag (Ubuntu 20.04 based) to ensure GLIBC compatibility with base-runner:latest
# Ubuntu 24.04 has GLIBC 2.38 which is incompatible with base-runner's older GLIBC

FROM gcr.io/oss-fuzz-base/base-builder

# Add LLVM 14 repository for Ubuntu 20.04 (focal)
RUN apt-get update && apt-get install -y \
    wget \
    gnupg \
    software-properties-common \
    && wget -O - https://apt.llvm.org/llvm-snapshot.gpg.key | apt-key add - \
    && add-apt-repository "deb http://apt.llvm.org/focal/ llvm-toolchain-focal-14 main" \
    && apt-get update

# Install LLVM 14 and libc++ 14, plus libclang for Python clang bindings,
# and common build tools that downstream project Dockerfiles often need
# (avoids fragile in-container apt fetches against archive.ubuntu.com)
RUN apt-get install -y \
    clang-14 \
    llvm-14 \
    llvm-14-dev \
    llvm-14-tools \
    llvm-14-runtime \
    libc++-14-dev \
    libc++abi-14-dev \
    libclang-14-dev \
    python3-clang-14 \
    pkg-config \
    libtool \
    automake \
    autoconf \
    texinfo \
    && rm -rf /var/lib/apt/lists/*

# Symlink libclang.so for python-clang bindings to find it
RUN ln -sf /usr/lib/llvm-14/lib/libclang.so.1 /usr/lib/x86_64-linux-gnu/libclang.so

# Install wllvm for bitcode extraction
RUN pip3 install wllvm

# IMPORTANT: do NOT symlink llvm-14's libc++ into the system path
# (/usr/lib/x86_64-linux-gnu). Overriding the system libc++ replaces the one the
# *default* OSS-Fuzz clang links fuzzers against → ABI/version mismatch →
# fuzz-target link failures ("undefined reference to main" / libc++ errors).
# This image is ADDITIVE by design: clang-14 lives at /usr/lib/llvm-14 purely for
# bitcode extraction (the extractor invokes it by explicit path via wllvm); the
# default fuzzer toolchain and the system libc++ are left UNTOUCHED. That makes
# this image safe as the canonical base-builder for BOTH fuzzer builds and
# extraction. clang-14's own -stdlib=libc++ resolves against /usr/lib/llvm-14/lib
# (its install-relative lib dir), so extraction needs no system symlink either.

# Verify installation (clang-14 at its own prefix; system toolchain untouched)
RUN clang-14 --version && \
    llvm-config-14 --version && \
    which wllvm && \
    test -x /usr/lib/llvm-14/bin/clang && \
    test -f /usr/lib/llvm-14/lib/libc++.so

# Set environment variables for LLVM 14
ENV LLVM_CONFIG=/usr/bin/llvm-config-14
